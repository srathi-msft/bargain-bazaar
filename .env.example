# Copy to .env (never commit .env; Start-Game.ps1 does it for you on first run). Only LLM_PROVIDER needs changing to switch models;
# everything else is per provider.
# The AI only talks. Prices, wallets and scores are decided by code, so any model (or none) keeps the game fair.

# --- Which model speaks for the shopkeeper ---
# none   = built-in lines only: no AI, no account, no cost. The default, so a fresh clone runs with zero setup.
# azure  = a chat model deployed in YOUR Azure AI resource (GPT, Grok, ...), signed in with the Azure CLI (no keys stored)
# claude = Anthropic Claude: on Azure AI Foundry (Azure CLI sign-in) or api.anthropic.com (with ANTHROPIC_API_KEY)
# gemini = Google Gemini through Google AI Studio (needs GEMINI_API_KEY)
LLM_PROVIDER=none
# azure: https://<your-resource>.cognitiveservices.azure.com
LLM_ENDPOINT=
# your deployment name (azure) or model name (claude, gemini)
LLM_MODEL=

# --- Azure sign-in (providers azure and claude when no API key is set) ---
# This app NEVER uses the Azure CLI's default subscription: it needs the subscription that owns the resource, and it refuses to
# run if the CLI is signed in as any account other than the one below (so a different account that happens to be signed in,
# for example a work account, can never be used by mistake).
AZURE_SUBSCRIPTION_ID=
AZURE_ALLOWED_ACCOUNT=
# Reasoning models only (minimal | low | medium | high). Leave empty otherwise.
AZURE_OPENAI_REASONING_EFFORT=

# --- Examples for the other providers (uncomment ONE block, comment the azure lines above) ---
# Claude on Azure AI Foundry (the subscription needs a payment method for Anthropic's Marketplace terms):
#   LLM_PROVIDER=claude
#   LLM_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
#   LLM_MODEL=claude-sonnet-5-5
# Claude directly from Anthropic:
#   LLM_PROVIDER=claude
#   LLM_MODEL=claude-sonnet-5-5
#   ANTHROPIC_API_KEY=sk-ant-...
# Gemini (get a key at https://aistudio.google.com/apikey; the free tier is too small for a full room, enable billing):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-flash-latest
#   GEMINI_API_KEY=...

# --- Call budget ---
# Max AI replies per minute (the rest use built-in lines) and seconds a reply may take before a built-in line is used.
LLM_RPM=400
LLM_TIMEOUT_S=8

# --- Hosting ---
PORT=8000
# Public URL players use (set by Start-Game.ps1 when a dev tunnel is created)
PUBLIC_URL=
# Host-only key for the admin screen. Start-Game.ps1 generates one on first run and keeps it here, so it stays the same
# across restarts. Never share it.
ADMIN_KEY=
